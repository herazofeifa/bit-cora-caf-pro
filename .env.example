# Copy to .env and fill in. Never commit real values of server-only keys.
# Browser (publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Server-only secret (set in the hosting environment, not in this file)
SUPABASE_SERVICE_ROLE_KEY=
